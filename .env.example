# CareerPilot AI configuration. Copy to ".env" in the project root and edit.
# Every value is read from the environment; nothing secret is hardcoded in the code.

# ---- Environment ------------------------------------------------------------
# "production" turns on Secure cookies and refuses to start without SECRET_KEY.
ENVIRONMENT=development

# ---- Auth -------------------------------------------------------------------
# Required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_EXPIRE_MINUTES=10080
# COOKIE_SECURE=true        # defaults to true in production, false in development
# COOKIE_SAMESITE=lax

# ---- Database -----------------------------------------------------------------
# Default: SQLite at backend/careerpilot.db (zero setup, fine for one server).
# Production: PostgreSQL. Render/Railway "postgres://..." URLs are converted automatically.
# DATABASE_URL=postgresql+psycopg://careerpilot:careerpilot@localhost:5432/careerpilot

# ---- AI (optional, but needed for AI answers, AI interview questions and AI scoring) ---
# Easiest: a free Google Gemini key from https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
#
# Or any OpenAI-compatible API (OpenAI, IBM watsonx/Granite gateway, Groq, Together, local Ollama):
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
#
# Without a key the app still works: questions come from the bank, answers are scored by a
# transparent rubric and the assistant answers from search. The UI says which engine was used.
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2

# ---- Rate limits (per client IP) ------------------------------------------------
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_AI=20/minute
RATE_LIMIT_CODE=30/minute

# ---- Code runner ------------------------------------------------------------------
CODE_TIMEOUT_SECONDS=4
CODE_MEMORY_MB=256

# ---- Resume uploads -------------------------------------------------------------
MAX_UPLOAD_MB=5
# UPLOAD_DIR=./backend/uploads

# ---- Optional GitHub analysis ----------------------------------------------------
GITHUB_ENABLED=true
GITHUB_TOKEN=

# ---- Frontend dev server only (npm run dev on :3000 calling the API on :8000) ----------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
